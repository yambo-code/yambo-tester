 | self_energy                                 # Self-energy and quasi-particle corrections
 | #
 | # ==== MPI (V=parallel) ===
 | HFlXC_CPU= "2.1.1.1"                        # CPUs for each role
 | HFlXC_ROLEs= "qp.g.q.b"                     # CPUs roles (qp,g,q,b)
 | DIP_CPU= "2.1.1"                            # CPUs for each role
 | DIP_ROLEs= "k.c.v"                          # CPUs roles (k,c,v)
 | PPA_CPU= "2.1.1.1.1"                        # CPUs for each role
 | PPA_ROLEs= "q.g.k.c.v"                      # CPUs roles (q,g,k,c,v)
 | PPA_nCPU_LinAlg_INV=-1                      # CPUs for Linear Algebra (if -1 it is automatically set)
 | GW_CPU= "2.1.1.1"                           # CPUs for each role
 | GW_ROLEs= "qp.g.q.b"                        # CPUs roles (qp,g,q,b)
 | #
 | # ==== Bosons (V=bosons) ===
 | BoseTemp= 0.000000                   [K]    # Bosonic Temperature
 | #
 | # ==== Fields (V=fields) ===
 | EF_interaction= "r.E"                       # Interaction kind (r.E|p.A)
 | #
 | # ==== Dipoles (V=dipoles) ===
 | % DipBands
 |   1 | 15 |                                  # Bands range for dipoles
 | %
 | DipComputed= " R V P [G-space]"             # [default R P V; extra P2 Spin Orb]
 | #
 | # ==== Hartree-Fock (V=hf) ===
 | EXXRLvcs= 201                        [RL]   # Exchange    RL components
 | VXCRLvcs= 10833                      [RL]   # XCpotential RL components
 | #
 | # ==== Plasmon-Pole dielectric matrix (V=X) ===
 | PPA_GrFnTp= "R"                             # Time-order: T R r Ta Ra. (T)ordered,(R)etarded,(r)sonant,(a)nti-resonant
 | PPA_NGsBlk=  43                      [RL]   # Response block size
 | % PPA_QpntsR
 |   1 |  8 |                                  # Transferred momenta
 | %
 | % PPA_BndsRn
 |   1 | 15 |                                  # Polarization function bands
 | %
 | % PPA_LongDr
 |  1.000000 | 1.000000 | 1.000000 |           # [cc] Electric Field
 | %
 | PPA_CGrdSp= 100.0000                        # [o/o] Poles coarse grid controller
 | #
 | # ==== Plasmon-Pole ===
 | PPA_PPAPnt= 27.21138                 [eV]   # PPA imaginary energy
 | #
 | # ==== TDDFT ===
 | TDDFTKernel= "HARTREE"                      # TDDFT Kernel: IP/Hartree/ALDA/LRC/PF/BSfxc
 | #
 | # ==== GW (V=gw) ===
 | % GbndRnge
 |   1 | 15 |                                  # G[W] bands range
 | %
 | #
 | # ==== Self-energy (V=qp) ===
 | SEApprox= "PPA"                             # Self-energy approximation ("HF","COHSEX","PPA")
 | DysSolver= "n"                              # Dyson Equation solver ("n","s","g")
 | GDamping= 0.100000                   [eV]   # G[W] damping
 | ExtendOut                       # Print all variables in the output file
